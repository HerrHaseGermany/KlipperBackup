# =========================================================
# KlipperCameraControl
# =========================================================
#
# Camera exposure control for Klipper.
#
# The installation script automatically replaces the
# command path with the actual KlipperCameraControl path.
#
# =========================================================


# =========================================================
# Camera exposure shell command
# =========================================================

[gcode_shell_command camera_exposure]
command: /home/biqu/KlipperCameraControl/set_camera_exposure.sh
timeout: 5.
verbose: True


# =========================================================
# Manual exposure control
#
# Example:
#
# CAM_EXPOSURE VALUE=250
# =========================================================

[gcode_macro CAM_EXPOSURE]
description: Set camera exposure
gcode:
    {% set value = params.VALUE|default(100)|int %}

    {% if value < 3 or value > 2047 %}
        { action_raise_error("Exposure must be between 3 and 2047") }
    {% endif %}

    RUN_SHELL_COMMAND CMD=camera_exposure PARAMS={value}

[gcode_shell_command camera_focus]
command: /home/biqu/KlipperCameraControl/set_camera_focus.sh
timeout: 5.0
verbose: True

[gcode_macro CAM_FOCUS]
description: Set manual camera focus (0-250, step 5)
gcode:
    {% set focus = params.VALUE|default(40)|int %}
    RUN_SHELL_COMMAND CMD=camera_focus PARAMS={focus}
